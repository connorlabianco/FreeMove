<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- .NET Framework 4.8: use the modern path handling so long paths work (ignored by .NET 8,
         which supports long paths already) -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
